# Скопируйте в .env и заполните. Файл .env исключён из Git — не коммитьте ключи.

# --- База данных ---
POSTGRES_USER=alfa
POSTGRES_PASSWORD=change-me
POSTGRES_DB=alfainsight
DATABASE_URL=postgres://alfa:change-me@db:5432/alfainsight?sslmode=disable

# --- Авторизация ---
# Случайная строка не короче 32 символов: openssl rand -base64 48
JWT_SECRET=
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost:3000

# --- Языковая модель (выдаётся организаторами) ---
# Адрес OpenAI-совместимого API, например https://<host>/v1
LLM_BASE_URL=https://changellenge.up.railway.app/v1
# Резервный адрес из инструкции организаторов (переключение — вручную):
# LLM_BASE_URL=https://api.alfahack-gateway26.ru/v1
# Ключ хранится только здесь. Не добавляйте его в код, логи и frontend.
LLM_API_KEY=
# Только модели из утверждённого списка кейса (Приложение 3). Точные
# идентификаторы — из инструкции организаторов; проверка: go run ./cmd/llmcheck
LLM_MODEL_FAST=google/gemma-4-26b-a4b-it
LLM_MODEL_REASONING=z-ai/glm-5.3-flash
LLM_MODEL_WRITER=qwen/qwen3.6-35b-a3b
LLM_TIMEOUT=90s
LLM_JSON_MODE=true

# --- Ограничения расхода (дневной лимит ключа — 500 руб., цена токена неизвестна) ---
LLM_DAILY_TOKEN_BUDGET=300000
LLM_DAILY_CALL_LIMIT=80
LLM_PER_MINUTE_LIMIT=6
LLM_MAX_OUTPUT_TOKENS=2200
LLM_MAX_INPUT_CHARS=24000
# Сколько полных анализов один пользователь может запустить в час
ANALYZE_PER_USER_HOURLY=10
# Фоновых запросов к модели нет: анализ запускается только по кнопке пользователя.

# --- Новости ---
NEWS_FETCH_ENABLED=true
NEWS_FETCH_INTERVAL=60m
NEWS_INITIAL_DAYS=7
APP_TIMEZONE=Europe/Moscow
